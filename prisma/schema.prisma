generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  userEmail  String   @unique
  firstName  String?
  lastName   String?
  password   String
  profilePic String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("core_user")
}
